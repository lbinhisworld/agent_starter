# 后端本地环境配置模板
#
# 用法：
#   cp .env.example .env        # 复制一份本地配置
#   # 然后修改 .env 中的 DATABASE_URL 口令等
#
# .env 为本地主配置（git 忽略，勿提交）。
# .env.local 为可选覆盖文件（git 忽略）：存在时会在 .env 之后加载并覆盖同名变量，
#   适合临时改端口/口令而不动 .env。详见 src/config.ts。
#
# 完整变量与默认值见 src/config.ts 的 envSchema。

# 数据库连接（必填；口令需与 MariaDB/MySQL 中对应账号一致）
DATABASE_URL="mysql://smart_cto_app:change_me@127.0.0.1:3306/smart_cto"

# 监听端口（默认 3000；本地联调固定 6668）
PORT=6668

# 监听地址（0.0.0.0 允许局域网访问；127.0.0.1 仅本机）
# HOST=0.0.0.0

# JWT（未设置 JWT_SECRET 时使用 dev_jwt_secret，仅限开发；生产必须显式设置）
# JWT_SECRET=
# JWT_EXPIRES_IN 默认 30d

# 可选：MySQL 会话时区（默认 +08:00）
# DATABASE_SESSION_TIMEZONE=+08:00
